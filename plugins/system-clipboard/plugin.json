{
  "id": "system-clipboard",
  "name": "系统剪贴板",
  "version": "1.0.0",
  "description": "系统剪贴板增强，支持历史记录、搜索、图片、文件、收藏和底部快捷面板。",
  "icon": "assets/icon.svg",
  "keywords": ["clipboard", "copy", "paste", "剪贴板", "剪切板", "复制", "粘贴"],
  "categories": ["system"],
  "runtime": "builtin",
  "entry": "builtin.ts",
  "builtin": {
    "module": "builtin.ts",
    "bridge": "host.clipboard",
    "host_commands": ["clipboard.open"]
  },
  "permissions": ["clipboard:read", "clipboard:write"],
  "commands": [
    {
      "id": "clipboard.open",
      "title": "打开系统剪贴板",
      "keyword": "clipboard",
      "input": "none"
    }
  ]
}
